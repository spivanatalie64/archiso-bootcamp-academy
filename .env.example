# ArchISO Bootcamp Academy -- worker configuration template
# Copy to .env locally or set as worker secrets. NEVER commit a real value.

# HAPPY_TOKEN -- GitLab account token for gitlab.acreetionos.org.
# The build-connect worker uses it to create learner build projects on our
# GitLab instance and trigger their CI/CD pipelines. The real value lives in
# secure storage only -- never in this repo, never in chat.
HAPPY_TOKEN=

# The GitLab instance the academy builds on.
GITLAB_BASE_URL=https://gitlab.acreetionos.org
